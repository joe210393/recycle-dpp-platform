PORT=3000

# SENWEI Zeabur：實際 host/port/database 範本見根目錄 `.env.zeabur.example`（密碼請填在
# 本機 `.env.zeabur`；該檔已在 .gitignore，勿提交）。

# ---------------------------------------------------------------------------
# Zeabur 部署檢查清單（recycle-dpp-platform + MySQL + 持久硬碟）
#
# 1) MySQL：務必設對「資料庫名稱」。Zeabur 預設常為 zeabur；若未設定
#    MYSQL_DATABASE，本專案會連到 recycle_dpp_platform（另一個 DB），你在
#    phpMySQL / Workbench 看 zeabur 會覺得「都沒寫入」。
#
# 2) 建議在 Zeabur 用「變數參考」把 MySQL 服務的連線注入 Node 服務，不要貼明文密碼。
#
# 3) 硬碟掛載在 /data 時，上傳檔必須寫入同一路徑，否則圖片寫在容器層、重啟就沒了：
#    UPLOAD_DIR=/data
#
# 4) 啟動日誌會印：[bootstrap] DB target host=... database=...
#    請確認 database= 與你在 MySQL 裡查的 schema 一致。
# ---------------------------------------------------------------------------

# 方式 A：Zeabur 注入的離散變數（與面板「連線資訊」對齊）
# MYSQL_HOST=<Zeabur 提供的主機，內網或公開視你的設定>
# MYSQL_PORT=3306
# MYSQL_USERNAME=root
# MYSQL_PASSWORD=<請用變數參考>
# MYSQL_DATABASE=zeabur

# 方式 B：若平台只給連線字串（本專案會解析 mysql://...）
# MYSQL_URI=mysql://root:password@host:3306/zeabur
# 仍可用 MYSQL_DATABASE 覆寫資料庫名稱（選用）

UPLOAD_DIR=/data

# 上傳單檔上限（MB，預設 20）
# UPLOAD_MAX_MB=20

# 上傳流程除錯（1/true/yes/on）
# DEBUG_UPLOAD_LOG=1

# ---------------------------------------------------------------------------
# 本機開發（可沿用 DB_*；未設定 MYSQL_* 時也會用這組）
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=recycle_dpp_platform
