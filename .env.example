# ---------------------------------------------------------------------------
# 使用方式：複製為 .env 並填密碼（.env 不會被 git 追蹤）
#   cp .env.example .env
#
# 本機：`npm start` 會自動載入 .env
# Zeabur：`npm run zeabur:print-env | pbcopy` → 面板「Edit as Raw」貼上（已略過 PORT）
# ---------------------------------------------------------------------------

# PORT=3000
# 本機開發可取消上一行註解；勿在 Zeabur 設定 PORT=3000

MYSQL_HOST=your_mysql_host
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=zeabur
UPLOAD_DIR=/data

# 上傳單檔上限（MB，預設 20）
# UPLOAD_MAX_MB=20
# DEBUG_UPLOAD_LOG=1

# 若平台只給連線字串（選用，见 src/config/env.js）
# MYSQL_URI=mysql://root:password@host:3306/zeabur

# ---------------------------------------------------------------------------
# 僅本機、不想用 MYSQL_* 時可改用 DB_*
# ---------------------------------------------------------------------------
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=change_me
# DB_NAME=recycle_dpp_platform
