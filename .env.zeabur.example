# SENWEI @ Zeabur（範本，可提交 git）
# 使用方式：
#   1) 複製為 .env.zeabur 並填 MYSQL_PASSWORD（.env.zeabur 已在 .gitignore，勿提交）
#   2) Zeabur 後台「環境變數」請逐項新增與下方相同的 key（密碼請用變數參考，勿貼聊天室）

PORT=3000

MYSQL_HOST=150.109.72.98
MYSQL_PORT=31662
MYSQL_USERNAME=root
MYSQL_PASSWORD=
MYSQL_DATABASE=zeabur

# 與 Zeabur 硬碟掛載路徑一致（你截圖為 /data）
UPLOAD_DIR=/data

# 複製為 .env.zeabur 並填密碼後，可執行：npm run zeabur:print-env
# （再貼到 Zeabur → 環境變數 → Edit as Raw）步驟見根目錄 Zeabur設定步驟.txt
