<!DOCTYPE html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= data.passport.product_name %>｜商品護照｜SENWEI</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
  </head>
  <body>
    <header class="header">
      <div class="container nav">
        <a class="brand" href="/">
          <img src="/assets/logo.jpg" alt="SENWEI logo">
          <span class="brand-name">SENWEI</span>
        </a>
        <nav class="nav-links">
          <a href="/" data-nav>首頁</a>
          <a href="/about" data-nav>關於我們</a>
          <a href="/product" data-nav>商品頁</a>
          <a href="/passport" data-nav class="active">商品護照</a>
          <%- include('nav-auth') %>
        </nav>
      </div>
    </header>

    <main>
      <% const show = (data.config && data.config.show) ? data.config.show : {}; %>
      <% const traceShow = show.recyclersAndTrace || {}; %>
      <%
        function fmtDate(v) {
          if (!v) return '';
          var s = String(v);
          var m = s.match(/^(\d{4}-\d{2}-\d{2})/);
          return m ? m[1] : s;
        }
      %>

      <section class="page-hero">
        <div class="container">
          <div class="breadcrumb">
            <a href="/">首頁</a><span>/</span>
            <a href="/passport">商品護照查詢</a><span>/</span>
            <span>護照詳情</span>
          </div>
          <span class="eyebrow">Product Passport</span>
          <% if (show.product && show.product.name) { %>
            <h1><%= data.passport.product_name %></h1>
          <% } else { %>
            <h1>商品護照</h1>
          <% } %>
          <p>護照代碼：<%= data.passport.passport_code %></p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="/passports/<%= data.passport.passport_code %>/export?format=json&view=<%= data.viewType %>" download>下載 DPP（JSON）</a>
            <a class="btn btn-secondary" href="/passports/<%= data.passport.passport_code %>/export?format=csv&view=<%= data.viewType %>" download>下載 DPP（CSV）</a>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="grid-2" style="align-items: start;">
            <div class="form-card">
              <span class="eyebrow">商品資訊</span>
              <div class="kv" style="margin-top: 20px;">
                <strong>分類</strong><span><%= data.passport.product_category || '-' %></span>
                <% if (show.product && show.product.productVersion) { %>
                  <strong>商品版本</strong><span><%= data.passport.version_no %><% if (data.passport.version_name) { %>（<%= data.passport.version_name %>）<% } %></span>
                <% } %>
                <% if (show.product && show.product.productBatchNo) { %>
                  <strong>商品批次</strong><span><%= data.passport.batch_no %></span>
                <% } %>
                <% if (data.passport.manufacture_date) { %>
                  <strong>製造日期</strong><span><%= fmtDate(data.passport.manufacture_date) %></span>
                <% } %>
                <% if (data.passport.expiry_date) { %>
                  <strong>有效日期</strong><span><%= fmtDate(data.passport.expiry_date) %></span>
                <% } %>
              </div>

              <% if (show.product && show.product.shortDescription && data.passport.product_short_description) { %>
                <p style="margin-top: 18px;"><%= data.passport.product_short_description %></p>
              <% } %>
              <% if (show.product && show.product.usageInstruction && data.passport.usage_instruction) { %>
                <p><strong>使用方式：</strong><%= data.passport.usage_instruction %></p>
              <% } %>
              <% if (show.product && show.product.caution && data.passport.caution) { %>
                <p><strong>注意事項：</strong><%= data.passport.caution %></p>
              <% } %>
              <% if (show.product && show.product.specification && data.passport.specification) { %>
                <p><strong>規格：</strong><%= data.passport.specification %></p>
              <% } %>
            </div>

            <% if (show.product && show.product.mainImage && data.passport.product_main_image) { %>
              <div class="card">
                <img src="<%= data.passport.product_main_image %>" alt="<%= data.passport.product_name %>" style="border-radius: 18px;" />
              </div>
            <% } else { %>
              <div class="form-card">
                <span class="eyebrow">關於商品護照</span>
                <div class="feature-list">
                  <li>公開材料組成與材料批次</li>
                  <li>回收來源與處理紀錄追溯</li>
                  <li>檢測報告摘要與文件</li>
                </div>
              </div>
            <% } %>
          </div>
        </div>
      </section>

      <% if (show.materials && show.materials.materialList) { %>
        <section class="section-sm">
          <div class="container">
            <div class="form-card">
              <span class="eyebrow">材料資訊</span>
              <% if (!data.materials || data.materials.length === 0) { %>
                <p class="muted" style="margin-top: 16px;">此批次尚未設定材料。</p>
              <% } else { %>
                <div class="detail-table-wrap" style="margin-top: 16px;">
                  <table class="detail-table">
                    <thead>
                      <tr>
                        <th>材料</th>
                        <th>角色</th>
                        <th>材料批次</th>
                        <th>製成日期</th>
                        <th>有效日期</th>
                        <% if (show.testingAndReports && show.testingAndReports.testReportSummary) { %>
                          <th>檢測報告摘要</th>
                        <% } %>
                      </tr>
                    </thead>
                    <tbody>
                      <% for (const m of data.materials) { %>
                        <tr>
                          <td><%= m.material_name %></td>
                          <td><%= m.material_role || '-' %></td>
                          <td><%= m.material_batch_no %></td>
                          <td><%= fmtDate(m.produced_date) || '-' %></td>
                          <td><%= fmtDate(m.expiry_date) || '-' %></td>
                          <% if (show.testingAndReports && show.testingAndReports.testReportSummary) { %>
                            <td><%= m.test_report_summary || '-' %></td>
                          <% } %>
                        </tr>
                      <% } %>
                    </tbody>
                  </table>
                </div>
              <% } %>

              <% if (show.documents && show.documents.showDocumentsList && data.documents && data.documents.length > 0) { %>
                <h3 style="margin: 24px 0 0; color: var(--heading);">文件列表</h3>
                <ul class="doc-list">
                  <% for (const d of data.documents) { %>
                    <li>
                      <div><strong><%= d.title %></strong>（<%= d.document_type %>）</div>
                      <% if (d.summary) { %>
                        <div class="muted"><%= d.summary %></div>
                      <% } %>
                      <% if (d.file_path) { %>
                        <div style="margin-top: 6px;"><a href="<%= d.file_path %>" style="color: var(--sage-dark); font-weight: 600;">下載 / 查看</a></div>
                      <% } %>
                    </li>
                  <% } %>
                </ul>
              <% } %>
            </div>
          </div>
        </section>
      <% } %>

      <section class="section-sm">
        <div class="container">
          <div class="form-card">
            <span class="eyebrow">回收來源與處理資訊</span>
            <% if (!data.trace || data.trace.length === 0) { %>
              <p class="muted" style="margin-top: 16px;">此批次無可追溯資料。</p>
            <% } else { %>
              <ul class="trace-list" style="margin-top: 16px;">
                <% for (const t of data.trace) { %>
                  <li class="trace-item">
                    <div class="kv">
                      <% if (traceShow.recyclerName) { %>
                        <strong>回收廠商</strong><span><%= t.recycler_name %></span>
                      <% } %>
                      <% if (traceShow.recyclerCertificateNo) { %>
                        <strong>回收證號</strong><span><%= t.recycler_certificate_no || '-' %></span>
                      <% } %>
                      <% if (traceShow.recycledBatchTraceCode) { %>
                        <strong>追溯編號</strong><span><%= t.recycled_trace_code || '-' %></span>
                      <% } %>
                      <% if (traceShow.sourceLocation) { %>
                        <strong>來源地</strong><span><%= t.source_location || '-' %></span>
                      <% } %>
                      <% if (traceShow.processingProcessNo) { %>
                        <strong>處理單號</strong><span><%= t.process_no || '-' %></span>
                      <% } %>
                      <% if (t.process_date) { %>
                        <strong>處理日期</strong><span><%= fmtDate(t.process_date) %></span>
                      <% } %>
                      <% if (t.process_method) { %>
                        <strong>處理方式</strong><span><%= t.process_method %></span>
                      <% } %>
                    </div>
                    <% if (traceShow.traceUrl && t.recycled_trace_url) { %>
                      <div style="margin-top: 12px;">
                        <a class="btn btn-secondary" href="<%= t.recycled_trace_url %>" target="_blank" rel="noopener">前往追溯網站</a>
                      </div>
                    <% } %>
                  </li>
                <% } %>
              </ul>
            <% } %>
          </div>
        </div>
      </section>

      <% if (show.qrCode) { %>
        <section class="section-sm" style="padding-bottom: 88px;">
          <div class="container">
            <div class="form-card">
              <span class="eyebrow">QR Code</span>
              <% if (data.passport.qr_code_path) { %>
                <div style="margin-top: 16px; max-width: 220px;">
                  <img src="<%= data.passport.qr_code_path %>" alt="QR Code" style="border-radius: 16px;" />
                </div>
              <% } else { %>
                <p class="muted" style="margin-top: 16px;">尚未提供 QR Code 圖片。</p>
              <% } %>
            </div>
          </div>
        </section>
      <% } %>
    </main>

    <footer class="footer">
      <div class="container footer-inner">
        <div>
          <div class="tagline">SENWEI</div>
          <small>銀髮友善護膚品牌｜環境友善保養理念</small>
        </div>
        <small>網站製作：來就補多媒體行銷</small>
      </div>
    </footer>
  </body>
</html>
