<h1><%= title %></h1>

<% if (typeof query !== 'undefined' && query && query.saved) { %>
  <div class="admin-card" style="border-color: rgba(90, 140, 90, 0.4); background: rgba(244, 250, 244, 0.9); margin-bottom: 16px;">
    <div style="font-weight: 800; color: #2f5b34;">✓ 已儲存。</div>
  </div>
<% } %>

<div class="admin-toolbar">
  <a class="admin-btn admin-btn-primary" href="/admin/<%= resourceSlug %>/new">新增</a>
</div>

<div class="admin-table-wrap">
  <table class="admin-table">
    <thead>
      <tr>
        <% for (const f of listFields) { %>
          <th><%= f.label === 'ID' ? '編號' : f.label %></th>
        <% } %>
        <th class="actions">操作</th>
      </tr>
    </thead>
    <tbody>
      <% if (!rows || rows.length === 0) { %>
        <tr>
          <td colspan="<%= listFields.length + 1 %>">目前沒有資料。</td>
        </tr>
      <% } %>

      <% for (const row of (rows || [])) { %>
        <tr>
          <% for (const f of listFields) { %>
            <td>
              <%
                const raw = row[f.key];
                const isEmpty = raw === null || raw === undefined || raw === '';
              %>
              <% if (f.type === 'image') { %>
                <% if (!isEmpty && typeof raw === 'string') {
                  const isUploaded = raw.startsWith('/uploads/');
                  const stamp = row.updated_at
                    ? (typeof row.updated_at === 'string' ? row.updated_at : (row.updated_at && row.updated_at.toISOString ? row.updated_at.toISOString() : String(row.updated_at)))
                    : String(Date.now());
                  const src = isUploaded
                    ? raw + (raw.includes('?') ? '&' : '?') + 'v=' + encodeURIComponent(stamp)
                    : raw;
                %>
                  <img src="<%= src %>" alt="thumb" style="width:64px; height:48px; object-fit: cover; border-radius: 8px; border: 1px solid rgba(168, 175, 143, 0.25);" loading="lazy" />
                <% } else { %>
                  <span style="color: #888;">（無）</span>
                <% } %>
              <% } else { %>
                <%= isEmpty ? '' : raw %>
              <% } %>
            </td>
          <% } %>
          <td class="actions">
            <a href="/admin/<%= resourceSlug %>/<%= row.id %>/edit">編輯</a>
            <form
              method="POST"
              action="/admin/<%= resourceSlug %>/<%= row.id %>?_method=DELETE"
              onsubmit="return confirm('確定要刪除？此操作無法還原。<%= resourceSlug === 'recycled-batches' ? '（回收批次將一併移除關聯的處理紀錄、材料批次與商品用料鏈結。）' : '' %>');"
            >
              <input type="hidden" name="_method" value="DELETE" />
              <button class="admin-btn admin-btn-danger" type="submit">刪除</button>
            </form>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>

<div class="admin-pagination">第 <%= page %> 頁（每頁 <%= limit %> 筆）</div>
